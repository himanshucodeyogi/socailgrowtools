<!DOCTYPE html>
<html lang="en">
<head>
  <title>CoinBoost — Error</title>
  <%- include('partials/head') %>
</head>
<body class="auth-page">
  <div class="auth-container">
    <div class="auth-card card" style="text-align:center">
      <div style="font-size:3rem;margin-bottom:1rem">&#x26A0;&#xFE0F;</div>
      <h1 style="font-size:1.5rem;margin-bottom:.5rem">Something went wrong</h1>
      <p style="color:var(--color-text-muted)"><%= message || 'An unexpected error occurred.' %></p>
      <a href="/" class="btn btn-primary" style="margin-top:1.5rem;display:inline-block">Go Home</a>
    </div>
  </div>
</body>
</html>
