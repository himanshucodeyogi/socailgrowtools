<nav class="navbar">
  <div class="container navbar__inner">
    <a href="/dashboard" class="navbar__logo">
      <img src="/logo.png" alt="SocialGrowTools" width="30" height="30" style="border-radius:8px;object-fit:contain;" />
      SocialGrowTools
    </a>
    <div class="navbar__links">
      <a href="/earn"      class="<%= typeof activePage !== 'undefined' && activePage === 'earn'    ? 'active' : '' %>">Earn Coins</a>
      <a href="/boost"     class="<%= typeof activePage !== 'undefined' && activePage === 'boost'   ? 'active' : '' %>">Boost</a>
      <a href="/orders"    class="<%= typeof activePage !== 'undefined' && activePage === 'orders'  ? 'active' : '' %>">My Orders</a>
    </div>
    <div class="navbar__right">
      <!-- Theme toggle -->
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme" title="Toggle theme">
        <!-- Sun: shown in dark mode -->
        <svg class="ti-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon: shown in light mode -->
        <svg class="ti-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <span class="coin-badge" id="coin-balance">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
        <%= user.coins %>
      </span>
      <form action="/logout" method="POST" style="display:inline" class="navbar__logout">
        <button type="submit" class="btn btn-outline btn-sm">Logout</button>
      </form>

      <!-- Hamburger button — mobile only -->
      <button class="navbar__hamburger" id="nav-hamburger" aria-label="Toggle menu" onclick="toggleMobileNav()">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile dropdown menu -->
  <div class="navbar__mobile-menu" id="nav-mobile-menu">
    <a href="/earn"   class="<%= typeof activePage !== 'undefined' && activePage === 'earn'   ? 'active' : '' %>">Earn Coins</a>
    <a href="/boost"  class="<%= typeof activePage !== 'undefined' && activePage === 'boost'  ? 'active' : '' %>">Boost</a>
    <a href="/orders" class="<%= typeof activePage !== 'undefined' && activePage === 'orders' ? 'active' : '' %>">My Orders</a>
    <div class="navbar__mobile-footer">
      <form action="/logout" method="POST">
        <button type="submit" class="btn btn-outline btn-sm btn-full">Logout</button>
      </form>
    </div>
  </div>
</nav>
<script>
function toggleMobileNav() {
  document.getElementById('nav-mobile-menu').classList.toggle('open');
  document.getElementById('nav-hamburger').classList.toggle('open');
}
</script>
