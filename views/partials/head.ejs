<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Google Search Console Verification -->
<meta name="google-site-verification" content="PSXSwppGNwj2feSm5Ke1jIC0MGsXMtIfjosAv6yATlY" />

<!-- Primary SEO -->
<meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'SocialGrowTools — Free P2P social media engagement exchange. Earn coins by helping others grow, then boost your own YouTube & Instagram for free. No password, no ads.' %>" />
<meta name="keywords" content="free social media growth tools India, free Instagram followers India, free YouTube subscribers India, social media engagement exchange, earn coins grow Instagram, boost YouTube channel free, free YouTube likes, free Instagram likes, grow YouTube channel India, Instagram followers free India, social media marketing tools free, social exchange platform, free social media engagement, SocialGrowTools, CoinBoost" />
<meta name="author" content="SocialGrowTools" />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#F5C518" />
<link rel="canonical" href="<%= typeof canonical !== 'undefined' ? canonical : 'https://socialgrowtools.indevs.in' %>" />

<!-- Geo targeting India -->
<meta name="geo.region" content="IN" />
<meta name="geo.placename" content="India" />
<meta name="language" content="en-IN" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="SocialGrowTools" />
<meta property="og:title" content="<%= typeof metaTitle !== 'undefined' ? metaTitle : 'SocialGrowTools — Free Social Media Growth Exchange' %>" />
<meta property="og:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Free P2P social media engagement exchange. Earn coins by helping others, spend them to boost your YouTube & Instagram. 100% free, no ads, no password.' %>" />
<meta property="og:image" content="https://socialgrowtools.indevs.in/logo.png" />
<meta property="og:url" content="<%= typeof canonical !== 'undefined' ? canonical : 'https://socialgrowtools.indevs.in' %>" />
<meta property="og:locale" content="en_IN" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= typeof metaTitle !== 'undefined' ? metaTitle : 'SocialGrowTools — Free Social Media Growth Exchange' %>" />
<meta name="twitter:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Free P2P engagement exchange. Earn coins, boost your YouTube & Instagram for free.' %>" />
<meta name="twitter:image" content="https://socialgrowtools.indevs.in/logo.png" />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/logo.png" />
<link rel="apple-touch-icon" href="/logo.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/css/style.css" />

<!-- Inline theme init — runs before render to prevent flash -->
<script>
  (function(){
    var t = localStorage.getItem('cb-theme') || 'dark';
    document.documentElement.setAttribute('data-theme', t);
  }());
</script>
<script src="/js/theme.js" defer></script>
